# BOB TRONICS — frontend environment variables
# Copy this file to .env.local and fill in the values for your environment.
# NOTE: .env.local is gitignored — never commit real credentials.

# Backend API base URL. Must end with /api/v1 so endpoints resolve like
# /catalog/products/, /catalog/categories/, etc.
# Example (Render): https://bobtronics-store-backend-zdan.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Mock mode switch. "true" uses the local mock data; "false" calls the real backend.
# Defaults to false when unset.
NEXT_PUBLIC_USE_MOCK=false

# Google OAuth client ID. When set, the Google "Continue with Google" button is
# shown on sign-in / sign-up. Leave empty to hide it.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Public URL of this frontend (used for auth redirects, emails, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000
